# Nome exibido ao usuário final (opcional; vazio usa "Júris Office IA")
NEXT_PUBLIC_APP_NAME="Júris Office IA"

# --- Banco de dados (Neon / PostgreSQL) -------------------------------------------------
# URL "pooled" do Neon (host com -pooler). Usada pelo app em tempo de execução.
# Na Vercel, a integração Neon preenche esta variável automaticamente.
DATABASE_URL=
# URL direta (sem pooler), usada só pelas migrações. Opcional: se ausente, usa DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Só para desenvolvimento/testes SEM banco: permite guardar atendimentos na memória do servidor
# em produção. NUNCA definir na Vercel (funções serverless perdem os dados entre requisições).
# ALLOW_MEMORY_STORE=1

# Testes com PostgreSQL de verdade (opcional; ver README): npm run test:pg-real
# TEST_DATABASE_URL=postgres://usuario@localhost:5432/juris_test

# Site de testes fica fora de buscadores. Lida na hora do BUILD: defina antes de construir.
# INDEXAR_SITE=1

# --- Fases futuras (não usadas ainda) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER_API_KEY=
SIGNATURE_PROVIDER_API_KEY=
