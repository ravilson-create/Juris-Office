# Nome exibido ao usuário final (opcional; vazio usa "Júris Office IA")
NEXT_PUBLIC_APP_NAME="Júris Office IA"

# --- Banco de dados (Neon / PostgreSQL) -------------------------------------------------
# URL "pooled" do Neon (host com -pooler). Usada pelo app em tempo de execução.
# Na Vercel, a integração Neon preenche esta variável automaticamente.
DATABASE_URL=
# URL direta (sem pooler), usada só pelas migrações. Opcional: se ausente, usa DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Papel de banco restrito (só SELECT/INSERT/UPDATE/DELETE, sem DDL), usado pelo app em tempo de
# execução (ver docs/NEON-VERCEL.md, seção 3.1). Opcional: se ausente, usa DATABASE_URL (o papel
# dono) — é o caso normal em desenvolvimento local e nos testes.
APP_DATABASE_URL=

# Autenticação profissional local: contas e sessões no banco, sem confirmação de e-mail.
# Variáveis NEON_AUTH_* antigas não são necessárias para novos acessos.

# Só para desenvolvimento/testes SEM banco: permite guardar atendimentos na memória do servidor
# em produção. NUNCA definir na Vercel (funções serverless perdem os dados entre requisições).
# ALLOW_MEMORY_STORE=1

# Testes com PostgreSQL de verdade (opcional; ver README): npm run test:pg-real
# TEST_DATABASE_URL=postgres://usuario@localhost:5432/juris_test

# Site de testes fica fora de buscadores. Lida na hora do BUILD: defina antes de construir.
# INDEXAR_SITE=1

# Protege o site de demonstração com usuário/senha HTTP Basic (opcional; ver middleware.ts).
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# Segredo comparado com o cabeçalho Authorization da limpeza periódica (ver vercel.json e
# app/api/cron/limpeza). Gere uma string aleatória de 32+ caracteres.
CRON_SECRET=

# --- Fases futuras (não usadas ainda) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER_API_KEY=
SIGNATURE_PROVIDER_API_KEY=

# Assinatura profissional: somente sandbox nesta versão. Não utilizar chaves de produção.
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
# Webhook: https://SEU_DOMINIO/api/webhooks/asaas
# API fixada em https://api-sandbox.asaas.com/v3; token do webhook com 32+ caracteres.
